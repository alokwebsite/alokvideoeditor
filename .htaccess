# ========================================================
# Apache / cPanel / LiteSpeed URL Rewriting
# Hides .html extension from website URLs
# ========================================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Redirect /index.html to / (clean root)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirect /page.html to /page (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Internally serve page.html when /page is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
